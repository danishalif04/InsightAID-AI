# Copy to .env and adjust per environment. Never commit .env.

# Supabase project (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional, local dev only. Skips the /login redirect so you can look at
# page layout without a working Supabase session. Only takes effect under
# `vite dev` (src/routes/RequireAuth.jsx) — a production build ignores it
# unconditionally, so this is safe to leave set in your own .env.
# You will NOT see real data with this on: every page's Supabase query is
# scoped to auth.uid() by Row Level Security, which returns empty with no
# real session.
# VITE_DEV_BYPASS_AUTH=true
