{
  "name": "insightaid-demo",
  "version": "1.0.0",
  "private": true,
  "description": "INSIGHTAID AI - 2-minute motion graphic demo video (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "node scripts/stills.mjs",
    "render": "remotion render src/index.ts InsightAidDemo out/insightaid_demo.mp4 --codec=h264 --crf=18 --gl=angle",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/three": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
