dist
dist-ssr

# Environment
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Stray Expo CLI scaffold (this is a Vite app, not Expo — created by
